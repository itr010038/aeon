        "status_text",
        "separator",
        "sources_section"
      ]
    },
    "date_text": {
      "type": "Text",
      "props": {
        "text": "2026-05-21",
        "variant": "muted"
      }
    },
    "status_text": {
      "type": "Text",
      "props": {
        "text": "Quiet day, no activity recorded",
        "variant": "body"
      }
    },
    "separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
