    "sources_label": {
      "type": "Text",
      "props": {
        "text": "Sources",
        "variant": "caption"
      }
    },
    "log_status": {
      "type": "Text",
      "props": {
        "text": "log=missing",
        "variant": "caption"
      }
    },
    "cron_status": {
      "type": "Text",
      "props": {
        "text": "cron-state=ok",
        "variant": "caption"
      }
    }
